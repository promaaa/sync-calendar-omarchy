#!/usr/bin/env bash
# Store, look up and delete calendar-provider passwords in the system keyring
# (libsecret), the same way io.github.cahva.rdp-manager's omarchy-rdp-secret
# does for RDP connections.
#
# The password only ever moves over a pipe: `store` reads it from stdin and
# hands it to secret-tool's stdin, and `lookup` writes it to stdout. It is
# never an argv element, so it cannot appear in `ps` output.
#
# Usage:
#   omarchy-calendar-secret store  <account> [label]   # password on stdin
#   omarchy-calendar-secret lookup <account>           # password on stdout, exit 1 if unset
#   omarchy-calendar-secret has    <account>           # exit 0 if a password is stored
#   omarchy-calendar-secret delete <account>
set -uo pipefail

SECRET_TOOL=/usr/bin/secret-tool
SETSID=/usr/bin/setsid
SERVICE=omarchy-calendar-timetree

# If the keyring is locked, secret-tool blocks on a GUI prompt with no headless
# fallback. Cap every call so a locked keyring surfaces as an error instead of
# wedging the caller (the panel's own process timers included).
TIMEOUT_BIN=/usr/bin/timeout
LOOKUP_TIMEOUT=10
STORE_TIMEOUT=20

# Never exit 0 from an error path. The caller branches on the exit status, so a
# zero here would report a password as saved when it was not.
die() {
  local code=${2:-1}
  (( code == 0 )) && code=1
  printf 'omarchy-calendar-secret: %s\n' "$1" >&2
  exit "$code"
}

[[ -x "$SECRET_TOOL" ]] || die "secret-tool not found at $SECRET_TOOL (install the libsecret package)"

action=${1:-}
account=${2:-}
[[ -n "$action" ]] || die "usage: omarchy-calendar-secret {store|lookup|has|delete} <account> [label]" 64
[[ -n "$account" ]] || die "missing account" 64
[[ "$account" =~ ^[A-Za-z0-9][A-Za-z0-9._%+-]*@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid account: $account" 64

case "$action" in
  store)
    label=${3:-"TimeTree: $account"}
    # setsid strips the controlling terminal before secret-tool runs: on this
    # system secret-tool's password prompt opens /dev/tty directly rather than
    # reading fd 0, so whenever a controlling terminal exists the prompt waits
    # on a tty nobody is typing into and the timeout above is what eventually
    # kills it. No controlling terminal makes secret-tool fall back to reading
    # the piped stdin instead.
    "$TIMEOUT_BIN" "$STORE_TIMEOUT" "$SETSID" "$SECRET_TOOL" store \
      --label="$label" service "$SERVICE" account "$account"
    status=$?
    if (( status != 0 )); then
      (( status == 124 )) && die "timed out storing the password — the keyring may be locked" 124
      die "secret-tool store failed (exit $status)" "$status"
    fi
    ;;

  lookup)
    # `secret-tool lookup` exits 1 on no match, which is why it is used here
    # instead of its sibling `search` (exits 0 with empty stdout on no match).
    out=$("$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" lookup service "$SERVICE" account "$account" 2>/dev/null)
    status=$?
    if (( status != 0 )); then
      (( status == 124 )) && die "timed out reading the password — the keyring may be locked" 124
      exit 1
    fi
    [[ -n "$out" ]] || exit 1
    printf '%s' "$out"
    ;;

  has)
    "$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" lookup service "$SERVICE" account "$account" >/dev/null 2>&1
    ;;

  delete)
    # clear exits non-zero when nothing matched; that is not an error for us.
    "$TIMEOUT_BIN" "$LOOKUP_TIMEOUT" "$SECRET_TOOL" clear service "$SERVICE" account "$account" >/dev/null 2>&1 || true
    ;;

  *)
    die "unknown action: $action" 64
    ;;
esac
